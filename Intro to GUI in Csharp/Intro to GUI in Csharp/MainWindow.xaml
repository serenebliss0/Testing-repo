<Window x:Class="Intro_to_GUI_in_Csharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Intro_to_GUI_in_Csharp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock HorizontalAlignment="Left" Margin="95,107,0,0" TextWrapping="Wrap" Text="Please enter your name!" VerticalAlignment="Top" FontSize="24"/>
        <TextBox x:Name="userName" HorizontalAlignment="Left" Margin="105,175,0,0" TextWrapping="Wrap" Text="userName" VerticalAlignment="Top" Width="235" Height="42"/>
        <Button x:Name="ok" Content="OK" HorizontalAlignment="Left" Margin="400,186,0,0" VerticalAlignment="Top" Click="okClick"/>

    </Grid>
</Window>
