export component App {
    width: 400px;
    height: 200px;

    Rectangle {
        width: parent.width;
        height: parent.height;

        HorizontalLayout {
            Rectangle {
                width: 100px;
                height: 100px;
                background: #ff4d4d;   // red
                border-radius: 8px;
            }

            Rectangle {
                width: 100px;
                height: 100px;
                background: #4db8ff;   // blue
                border-radius: 8px;
            }

            Rectangle {
                width: 100px;
                height: 100px;
                background: #7dff7d;   // green
                border-radius: 8px;
            }
        }
    }
}
